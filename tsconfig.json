{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true
  },
  "include": [".astro/types.d.ts", "src/**/*.ts", "src/**/*.astro", "e2e/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "out", "test-results", "playwright-report"]
}
